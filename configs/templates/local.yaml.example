# Copy this file to configs/local/<name>.yaml and customize local paths.
experiment_name: local-bird-dev
benchmark: bird
bird_mode: dev
data_root: ${BIRD_ROOT}
output_dir: ${SQLMT_OUTPUT_ROOT}/local-bird-dev
mutation_profile: canonical
workers: 4
resume: true
overwrite: false

stages:
  normalize: true
  mutate: false
  equivalence: false
  execute: false
  counterexamples: false
  augment: false
  report: false

timeouts:
  verieql_seconds: 120
  sqlite_seconds: 120
  sqldriller_seconds: 300

tools:
  verieql_path: ${VERIEQL_ROOT}
  verieql_python: ${VERIEQL_PYTHON}
  sqldriller_path: null
